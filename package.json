{
  "name": "pi-shift-router",
  "version": "1.2.0",
  "description": "Task-level router + orchestrator for pi-coding-agent: LLM Judge routes each turn to a fast execution tier or a smart judgment tier, with multi-model fallback chains, exponential-backoff failover, and cache-aware routing; complex tasks escalate to a Smart CTO that delegates implementation to Fast subagents. Zero runtime dependencies.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi-agent",
    "shift-router",
    "model-routing",
    "ai-router",
    "llm-router",
    "orchestrator",
    "task-orchestration",
    "subagent",
    "model-selection",
    "task-classifier",
    "llm-judge",
    "two-tier-routing",
    "multi-model-fallback",
    "exponential-backoff",
    "agent-failover",
    "rate-limit-handling",
    "model-switching",
    "agent-routing",
    "auto-router",
    "cost-optimization"
  ],
  "license": "MIT",
  "homepage": "https://shiftrouter.greenerai.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/green-dalii/pi-shift-router.git"
  },
  "bugs": {
    "url": "https://github.com/green-dalii/pi-shift-router/issues"
  },
  "author": {
    "name": "green-dalii",
    "url": "https://github.com/green-dalii"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "minPiVersion": "0.80.0",
    "image": "https://raw.githubusercontent.com/green-dalii/pi-shift-router/main/assets/hero.jpeg"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "docs",
    "assets",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf node_modules dist",
    "pack:check": "npm pack --dry-run && node scripts/pack-check.mjs",
    "prepublishOnly": "npm run test && npm run build && npm run pack:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@earendil-works/pi-tui": "^0.81.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  }
}
